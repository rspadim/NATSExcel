<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- C# 9: the NATS.Net option objects use init-only setters (see IsExternalInit.cs). -->
    <LangVersion>9.0</LangVersion>
    <RootNamespace>NATSExcel</RootNamespace>
    <AssemblyName>NATSExcel</AssemblyName>
    <!-- Embedded in the NATS ClientName; the CI overrides it with the release tag. -->
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">dev</InformationalVersion>
    <!-- Release binaries must not embed the builder's local paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0-beta2" />
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0-beta2" />
    <PackageReference Include="ExcelDna.IntelliSense" Version="1.9.0-beta2" />
    <PackageReference Include="NATS.Client.Core" Version="3.3.0" />
    <PackageReference Include="NATS.Client.JetStream" Version="3.3.0" />
    <PackageReference Include="NATS.Client.KeyValueStore" Version="3.3.0" />
    <PackageReference Include="NATS.Client.ObjectStore" Version="3.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.0-rc3" />
    <!-- The vs-threading analyzer tripwire (PLAN V7.3 / R3): it makes the
         VSTHRD002/VSTHRD110/VSTHRD200 suppressions in the code real and flags
         new unbounded blocking on the Excel thread. Analyzer-only: it ships no
         lib, so it adds nothing to the packed closure (.dna). -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.6.40">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="test\**" />
    <None Remove="test\**" />
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- The JSON Schema ships inside the assembly (read by ConfigSchema at
       runtime and exposed through NatsUDFConfigSchema). -->
  <ItemGroup>
    <EmbeddedResource Include="NATSExcel.schema.json" />
    <None Remove="NATSExcel.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NATSExcel.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy the add-in dll next to the packed XLLs. -->
  <Target Name="CopyNatsExcelDllToPublish" AfterTargets="Build">
    <PropertyGroup>
      <OutputBase>$(ProjectDir)bin\$(Configuration)\$(TargetFramework)\</OutputBase>
      <SourceDll>$(OutputBase)NATSExcel.dll</SourceDll>
      <TargetDir>$(OutputBase)publish\</TargetDir>
    </PropertyGroup>
    <MakeDir Directories="$(TargetDir)" />
    <Copy SourceFiles="$(SourceDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
