<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>NatsValidate</AssemblyName>
    <RootNamespace>NatsExcel.Tools</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Release binaries must not embed the builder's local paths. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <!-- Same client the add-in uses, so every credential style is really tested. -->
  <ItemGroup>
    <PackageReference Include="NATS.Client.Core" Version="3.3.0" />
    <PackageReference Include="NATS.Client.JetStream" Version="3.3.0" />
    <!-- No NATS.NKeys reference: KeyPair comes in transitively through
         NATS.Client.Core (same as the add-in), so the validator derives the
         public NKey from the seed the same way the add-in does - Seed alone is
         not enough (the CONNECT then carries a signature and no public key, and
         an NKey server rejects it). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
