{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NATSExcel configuration",
  "description": "Schema for NATSExcel.json. Comments (// and /* */) are accepted by the loader. Values that do not match are dropped individually (the rest of the file is kept).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Default": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": { "type": "string", "description": "Cluster used when a formula passes no endpoint." },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Connect and sync timeout in milliseconds." },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user": { "type": ["string", "null"] },
            "password": { "type": ["string", "null"] },
            "token": { "type": ["string", "null"], "description": "Single server-wide shared secret." },
            "jwt": { "type": ["string", "null"], "description": "Operator-mode user JWT." },
            "nkeySeed": { "type": ["string", "null"], "description": "NKey seed (SU...); used alone or with jwt." },
            "credsFile": { "type": ["string", "null"], "description": "Path to a .creds file (JWT + seed)." },
            "tls": { "type": "boolean" },
            "tlsCert": { "type": ["string", "null"], "description": "Client certificate path for mTLS." },
            "tlsCertPassword": { "type": ["string", "null"] }
          }
        },
        "reconnect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": -1, "maximum": 2147483647 },
            "waitMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "jitterMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          }
        }
      }
    },
    "RTD": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "NatsUpdateRateMs": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "How often the poll timer reads NATS." },
        "ExcelUpdateRateMs": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "How often dirty values are flushed to Excel." },
        "MessageCounterThreshold": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807, "description": "Messages/second above which Automatic switches to timer delivery." },
        "NatsUpdateStyle": { "type": "string", "pattern": "^(?:[Tt][Ii][Mm][Ee][Rr]|[Rr][Ee][Aa][Ll][Tt][Ii][Mm][Ee]|[Aa][Uu][Tt][Oo][Mm][Aa][Tt][Ii][Cc])$", "description": "Timer, Realtime or Automatic (case-insensitive; ASCII)." },
        "cluster": { "type": ["string", "null"], "description": "Optional cluster override for RTD topics." }
      }
    },
    "UDF": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Connect and sync timeout in milliseconds." },
        "cluster": { "type": ["string", "null"], "description": "Optional cluster override for UDF calls." }
      }
    },
    "Servers": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Server aliases: name -> a nats:// URL or a comma-separated URL list."
    },
    "Clusters": {
      "type": "object",
      "description": "Named clusters: a set of URLs (Server aliases or inline URLs) plus optional overrides.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "urls": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Server aliases or inline nats:// URLs." },
          "expectCluster": { "type": "string", "description": "Optional: assert the cluster name the server announces (warning only)." },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "user": { "type": ["string", "null"] },
              "password": { "type": ["string", "null"] },
              "token": { "type": ["string", "null"] },
              "jwt": { "type": ["string", "null"] },
              "nkeySeed": { "type": ["string", "null"] },
              "credsFile": { "type": ["string", "null"] },
              "tls": { "type": "boolean" },
              "tlsCert": { "type": ["string", "null"] },
              "tlsCertPassword": { "type": ["string", "null"] }
            }
          },
          "jetstream": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain": { "type": ["string", "null"], "description": "JetStream domain for cross-cluster routing." }
            }
          },
          "reconnect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxAttempts": { "type": "integer", "minimum": -1, "maximum": 2147483647 },
              "waitMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
              "jitterMs": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
            }
          }
        }
      }
    },
    "JetStream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether JetStream features are used at all." },
        "defaultTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Default JetStream operation timeout." }
      }
    },
    "AllowAdminWrites": { "type": "boolean", "description": "Enable admin/destructive functions (Stream*/Consumer*/Purge/Delete). Default off." },
    "SkipRepeatedMessages": { "type": "boolean", "description": "Skip identical consecutive payloads for literal subjects and polled reads." },
    "CoalesceRealtimeUpdates": { "type": "boolean", "description": "Real-time: at most one push per window (superseded by an explicit ConflationMs)." },
    "ConflationMs": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "description": "Real-time conflation window in ms (0 = off; negative clamps to 0, >3600000 caps via Sanitize)." },
    "PublishDedupCacheSize": { "type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Capacity of the PublishIfChanged dedup cache (LRU)." },
    "SyncWrite": { "type": "string", "pattern": "^(?:[Ss][Yy][Nn][Cc]|[Ff][Ii][Rr][Ee][Ff][Oo][Rr][Gg][Ee][Tt]|[Ff][Ii][Rr][Ee][Ff][Oo][Rr][Gg][Ee][Tt]-[Aa][Ll][Ll])$", "description": "sync, fireforget or fireforget-all (case-insensitive; ASCII)." },
    "AsyncWrites": { "type": "boolean", "description": "Dispatch writes through Excel-DNA async so the Excel thread never blocks." },
    "UpdateCheck": { "type": "boolean", "description": "Check GitHub for a newer release in the background." }
  }
}
